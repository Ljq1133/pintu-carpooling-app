<?xml version="1.0" encoding="UTF-8"?>
<!--
  PinTu 后端 logback 配置。
  - 控制台输出包含 traceId，便于联调按请求追踪日志。
  - 敏感字段（password / token / phone 等）通过 SensitiveDataMaskingConverter 自动脱敏。
  - 生产 profile 下日志写入 ./logs/pintu.log，并按天滚动保留 14 天。
-->
<configuration scan="true" scanPeriod="60 seconds">

    <conversionRule conversionWord="mask"
                    converterClass="com.pintu.common.logging.SensitiveDataMaskingConverter"/>

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{traceId:-}] %-5level %logger{36} - %mask"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <springProfile name="prod">
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>./logs/pintu.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>./logs/pintu.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>50MB</maxFileSize>
                <maxHistory>14</maxHistory>
                <totalSizeCap>2GB</totalSizeCap>
            </rollingPolicy>
            <encoder>
                <pattern>${LOG_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
        <logger name="com.pintu" level="INFO"/>
    </springProfile>

    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.pintu" level="DEBUG"/>
    </springProfile>

</configuration>
