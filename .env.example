# ============================================================
# 后端必填项（生产环境必须显式设置，否则 ConfigurationGuard 会中止启动）
# ============================================================

# 数据加密密钥，用于 AES-GCM 字段加密
# 生成命令：openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# JWT 签名密钥，至少 32 字符高强度随机串，禁止使用 dev-only- 前缀
# 生成命令：openssl rand -base64 48
JWT_SECRET=

# Spring profile：dev / test / prod
SPRING_PROFILES_ACTIVE=dev

# 数据库连接（容器内时改为 jdbc:mysql://mysql:3306/pintu...）
DB_URL="jdbc:mysql://localhost:3306/pintu?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai"
DB_USERNAME=root
DB_PASSWORD=

# 后端 CORS 白名单，逗号分隔；prod profile 必填
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================================
# 前端构建参数（Vite 编译时注入，需要 VITE_ 前缀）
# ============================================================
VITE_API_BASE_URL=http://127.0.0.1:8080
VITE_API_MODE=http

# ============================================================
# 外部服务（MVP 默认 mock，可逐步替换为真实 Provider）
# ============================================================
MAP_PROVIDER=mock
MAP_CACHE_TTL_SECONDS=300
MAP_MAX_ATTEMPTS=2
MAP_TIMEOUT_MS=1500
SMS_PROVIDER=mock
IDENTITY_VERIFICATION_PROVIDER=mock
OBJECT_STORAGE_ROOT=./data/objects

